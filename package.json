{
  "name": "lexington",
  "version": "2.0.0",
  "description": "Lexington - Premium SEO-Optimized Ghost Theme by Wasim Akram Developer. Built for YMYL content, E-E-A-T signals, fully responsive with dark mode, structured data, built-in search, and blazing-fast performance.",
  "author": {
    "name": "Wasim Akram Developer",
    "email": "prodigitalwasim@gmail.com",
    "url": "https://github.com/wasimakramdev"
  },
  "license": "MIT",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "gpm": {
    "type": "theme",
    "categories": [
      "Minimal",
      "Magazine",
      "Blog",
      "SEO-Optimized"
    ]
  },
  "keywords": [
    "ghost-theme",
    "premium",
    "seo",
    "responsive",
    "dark-mode",
    "schema-markup",
    "reading-progress",
    "search",
    "members",
    "eeat",
    "ymyl",
    "accessible",
    "fast",
    "lexington"
  ],
  "config": {
    "posts_per_page": 12,
    "image_sizes": {
      "xxs": {
        "width": 30
      },
      "xs": {
        "width": 100
      },
      "sm": {
        "width": 300
      },
      "md": {
        "width": 600
      },
      "lg": {
        "width": 1000
      },
      "xl": {
        "width": 1400
      },
      "xxl": {
        "width": 2000
      }
    },
    "card_assets": true,
    "custom": {
      "show_author_bio": {
        "type": "boolean",
        "default": true
      },
      "show_related_posts": {
        "type": "boolean",
        "default": true
      },
      "show_toc": {
        "type": "boolean",
        "default": true
      },
      "show_reading_progress": {
        "type": "boolean",
        "default": true
      },
      "show_share_buttons": {
        "type": "boolean",
        "default": true
      },
      "show_newsletter_cta": {
        "type": "boolean",
        "default": true
      },
      "show_trust_badge": {
        "type": "boolean",
        "default": true
      },
      "show_disclaimer": {
        "type": "boolean",
        "default": true
      },
      "accent_color": {
        "type": "select",
        "options": [
          "Blue",
          "Green",
          "Red",
          "Purple",
          "Orange",
          "Teal"
        ],
        "default": "Blue"
      }
    }
  },
  "devDependencies": {
    "gscan": "^6.4.2"
  }
}
