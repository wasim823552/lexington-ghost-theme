{{!< default}}
<section class="member-page">
    <div class="member-card">
        <h1 class="member-card-title">Welcome back</h1>
        <p class="member-card-text">Sign in to your account to continue.</p>
        <div class="member-form">
            <input class="member-card-name-input" type="email" data-members-email placeholder="Your email address" autocomplete="email" aria-label="Email address">
            <input class="member-card-name-input" type="password" data-members-password placeholder="Your password" autocomplete="current-password" aria-label="Password">
            <button class="btn btn-primary" data-members-login type="button">Sign in</button>
        </div>
        <a class="member-card-link" href="#/portal/forgot-password">Forgot password?</a>
    </div>
</section>