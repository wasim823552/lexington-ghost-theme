{{!< default}}
<section class="member-page">
    <div class="member-card">
        <h1 class="member-card-title">Join us today</h1>
        <p class="member-card-text">Create a free account to get access to exclusive content and updates.</p>
        <div class="member-form">
            <input class="member-card-name-input" type="text" data-members-name placeholder="Your name" autocomplete="name" aria-label="Name">
            <input class="member-card-name-input" type="email" data-members-email placeholder="Your email address" autocomplete="email" aria-label="Email address">
            <button class="btn btn-primary" data-members-plan="free" type="button">Create account</button>
        </div>
        <a class="member-card-link" href="/signin/">Already have an account? Sign in</a>
    </div>
</section>