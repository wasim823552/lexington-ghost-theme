{{!< default}}
<section class="hero">
    <div class="hero-inner container">
        <h1 class="hero-title">{{@site.title}}</h1>
        {{#if @site.description}}
        <p class="hero-description">{{@site.description}}</p>
        {{/if}}
        <div class="hero-search">
            <form class="hero-search-form" data-search-form>
                <svg class="hero-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input type="search" class="hero-search-input" placeholder="Search permits, rules, city guides..." aria-label="Search articles" data-search-input>
            </form>
        </div>
    </div>
</section>

{{#if @custom.show_trust_badge}}
<section class="trust-bar">
    <div class="container">
        <div class="trust-bar-inner">
            <div class="trust-item">
                <svg class="trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                <span>Research-Based</span>
            </div>
            <div class="trust-item">
                <svg class="trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span>Verified Sources</span>
            </div>
            <div class="trust-item">
                <svg class="trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>Updated Regularly</span>
            </div>
            <div class="trust-item">
                <svg class="trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                <span>Expert Reviewed</span>
            </div>
        </div>
    </div>
</section>
{{/if}}

{{#get "posts" filter="featured:true" limit="1" as |featured|}}
{{#if featured}}
<section class="featured-section">
    <div class="container">
        {{#foreach featured}}
        {{> post-card-featured}}
        {{/foreach}}
    </div>
</section>
{{/if}}
{{/get}}

<section class="post-feed-section">
    <div class="container">
        <div class="post-feed" data-feed-layout="{{@custom.feed_layout}}">
            {{#foreach posts}}
            {{> post-card}}
            {{/foreach}}
        </div>
    </div>
</section>

{{> pagination}}
