{{!< default}}
<article class="page {{post_class}}">
    <header class="page-header">
        <div class="container">
            {{> breadcrumbs}}

            <h1 class="page-title">{{title}}</h1>
        </div>
    </header>

    <div class="page-body-wrapper">
        <div class="container">
            <div class="page-content">
                <div class="page-body">
                    {{content}}
                </div>
            </div>
        </div>
    </div>
</article>
