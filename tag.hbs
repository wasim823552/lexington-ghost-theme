{{!< default}}
<section class="tag-header">
    <div class="container">
        {{#if feature_image}}
        <div class="tag-header-image">
            <img
                srcset="{{img_url feature_image size="md"}} 800w,
                        {{img_url feature_image size="lg"}} 1200w"
                sizes="(max-width: 768px) 100vw, 1200px"
                src="{{img_url feature_image size="lg"}}"
                alt="{{name}}"
                width="1200"
                height="400"
                loading="eager"
            >
        </div>
        {{/if}}
        <div class="tag-header-content">
            <h1 class="tag-name">{{name}}</h1>
            {{#if description}}
            <p class="tag-description">{{description}}</p>
            {{/if}}
            <p class="tag-count">{{plural count singular="% post" plural="% posts" empty="No posts"}}</p>
        </div>
    </div>
</section>

<section class="post-feed-section">
    <div class="container">
        <div class="post-feed">
            {{#foreach posts}}
            {{> post-card}}
            {{/foreach}}
        </div>
    </div>
</section>

{{> pagination}}
