{{!-- Featured Post Card ----}}
<article class="post-card-featured">
    <a href="{{url absolute="true"}}" class="post-card-featured-link">
        {{#if feature_image}}
        <div class="post-card-featured-image-wrap">
            <img src="{{img_url feature_image size="lg"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="eager">
        </div>
        {{/if}}
        <div class="post-card-featured-content">
            <span class="post-card-featured-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                Featured
            </span>
            <h2 class="post-card-featured-title">{{title}}</h2>
            {{#if excerpt}}
            <p class="post-card-featured-excerpt">{{excerpt}}</p>
            {{/if}}
            <div class="post-card-meta">
                <div class="post-card-author-row">
                    {{#foreach authors}}
                    <span>{{name}}</span>
                    {{/foreach}}
                </div>
                <span class="post-card-reading-time">{{reading_time}}</span>
            </div>
        </div>
    </a>
</article>