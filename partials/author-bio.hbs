{{!-- Author Bio with E-E-A-T Signals --}}
{{#if @custom.show_author_bio}}
<div class="author-bio">
    <div class="author-bio-inner">
        {{#if profile_image}}
        <a href="{{url absolute="true"}}" class="author-bio-avatar-link">
            <img class="author-bio-avatar" src="{{img_url profile_image size="sm"}}" alt="{{name}}" width="80" height="80" loading="lazy">
        </a>
        {{/if}}
        <div class="author-bio-info">
            <a href="{{url absolute="true"}}" class="author-bio-name">Written by <strong>{{name}}</strong></a>
            {{#if bio}}
            <p class="author-bio-text">{{bio}}</p>
            {{/if}}
            {{#if website}}
            <a href="{{website}}" class="author-bio-website" rel="noopener noreferrer" target="_blank">{{website}}</a>
            {{/if}}
            {{#if location}}
            <span class="author-bio-location">{{location}}</span>
            {{/if}}
        </div>
    </div>
</div>
{{/if}}