{{!< default}}
<article class="post {{post_class}}">
    <header class="post-header">
        <div class="container">
            {{> breadcrumbs}}
            <div class="post-header-content">
                <div class="post-header-meta">
                    {{#if primary_tag}}
                    <a href="{{primary_tag.url}}" class="post-tag">{{primary_tag.name}}</a>
                    {{/if}}
                </div>
                <h1 class="post-title">{{title}}</h1>
                {{#if custom_excerpt}}
                <p class="post-excerpt">{{custom_excerpt}}</p>
                {{/if}}
                <div class="post-header-info">
                    <div class="post-header-author">
                        {{#foreach authors}}
                        <a href="{{url absolute="true"}}" class="post-header-author-link">
                            {{#if profile_image}}
                            <img class="post-header-avatar" src="{{img_url profile_image size="xs"}}" alt="{{name}}" width="40" height="40" loading="eager">
                            {{/if}}
                            <span>{{name}}</span>
                        </a>
                        {{/foreach}}
                    </div>
                    <div class="post-header-details">
                        <time class="post-header-date" datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="MMM D, YYYY"}}</time>
                        <span class="post-header-separator" aria-hidden="true">&middot;</span>
                        <span class="post-header-reading-time">{{reading_time}}</span>
                        <span class="post-header-separator" aria-hidden="true">&middot;</span>
                        <span class="post-header-updated">Updated: {{date updated_at format="MMM D, YYYY"}}</span>
                    </div>
                </div>
            </div>
        </div>
    </header>
    {{#if feature_image}}
    <figure class="post-feature-image">
        <div class="container">
            <img srcset="{{img_url feature_image size="md"}} 800w, {{img_url feature_image size="lg"}} 1200w, {{img_url feature_image size="xl"}} 2000w" sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1200px" src="{{img_url feature_image size="lg"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" width="1200" height="675" loading="eager">
            {{#if feature_image_caption}}
            <figcaption class="post-feature-image-caption">{{feature_image_caption}}</figcaption>
            {{/if}}
        </div>
    </figure>
    {{/if}}
    <div class="post-body-wrapper">
        <div class="container">
            <div class="post-layout">
                <div class="post-content">
                    {{> trust-indicators}}
                    <div class="post-body">{{content}}</div>
                    {{> disclaimer-box}}
                    {{> share-buttons}}
                </div>
                <aside class="post-sidebar">
                    {{> table-of-contents}}
                </aside>
            </div>
        </div>
    </div>
    <section class="post-bottom container">
        {{#foreach authors}}{{> author-bio}}{{/foreach}}
        {{> related-posts}}
        {{> newsletter-cta}}
    </section>
</article>